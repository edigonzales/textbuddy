# Diese Datei wird nicht automatisch geladen. Der Prozessmanager muss die Werte setzen.
TEXTBUDDY_AUTH_ENABLED=true
TEXTBUDDY_OIDC_ISSUER_URI=https://identity.example.com/realms/team
TEXTBUDDY_OIDC_CLIENT_ID=textbuddy
TEXTBUDDY_OIDC_CLIENT_SECRET='<secret>'

TEXTBUDDY_LLM_MODE=provider
TEXTBUDDY_LLM_BASE_URL=https://llm.example.com/v1
TEXTBUDDY_LLM_API_KEY='<secret>'
TEXTBUDDY_LLM_MODEL='<provider-model-id>'
TEXTBUDDY_LLM_TIMEOUT=30s
TEXTBUDDY_LLM_TEMPERATURE=0.2

TEXTBUDDY_LANGUAGETOOL_MODE=embedded
TEXTBUDDY_DOCUMENT_MODE=kreuzberg
TEXTBUDDY_DOCUMENT_MAX_UPLOAD_SIZE=20MB
TEXTBUDDY_MAX_TEXT_LENGTH=50000
TEXTBUDDY_MAX_PROMPT_LENGTH=2000
